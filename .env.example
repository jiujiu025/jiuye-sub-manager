# Docker Compose 部署时使用的环境变量示例
# 本地开发请在 backend/.env 中配置
JWT_SECRET_KEY=请替换为至少32位随机字符串
# 用于加密 3x-ui API Token、通知密钥等敏感数据；必须长期固定
ENCRYPTION_KEY=请替换为另一组至少32位随机字符串
APP_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码
PUBLIC_BASE_URL=https://sub.example.com
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
SUBSCRIPTION_RATE_LIMIT=120
SUBSCRIPTION_RATE_WINDOW_SECONDS=60
SYNC_INTERVAL_MINUTES=5
SCHEDULER_ENABLED=true
CACHE_TTL_SECONDS=300
UPSTREAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
# 节点健康告警，可选；未配置的渠道不会发送外部通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WECOM_BOT_WEBHOOK=
# 完整代理检测依赖 sing-box；Docker 镜像会自动安装
SING_BOX_PATH=sing-box
HEALTH_PROBE_MODE=full
HEALTH_TEST_URL=https://www.gstatic.com/generate_204
# 地区识别：名称识别优先，公网 IP 地理服务作为后台兜底；接口不可用不会影响同步
GEOIP_ENABLED=true
GEOIP_API_URL=https://ipwho.is/{ip}
GEOIP_TIMEOUT_SECONDS=4
GEOIP_CACHE_TTL_HOURS=168
GEOIP_ERROR_RETRY_MINUTES=30
GEOIP_BATCH_SIZE=100
GEOIP_INTERVAL_MINUTES=10
